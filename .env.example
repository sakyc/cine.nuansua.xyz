PORT=3000
NODE_ENV=development
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://lk21:change-me@127.0.0.1:55432/lk21?schema=public
DIRECT_URL=postgresql://lk21:change-me@127.0.0.1:55432/lk21?schema=public
TEST_DATABASE_URL=
OPENSUBTITLES_API_KEY=
REDIS_URL=
LK21_BASE_URL=https://tv13.lk21official.cc
LK21_BASE_URLS=
LK21_PROXY_URL=
CATALOG_TTL_SECONDS=1800
DETAIL_TTL_SECONDS=3600
CATALOG_SEED_PAGES=3
UPSTREAM_TIMEOUT_MS=8000
CRON_SECRET=replace-with-a-long-random-value
# Security
# Browser origins allowed to call the API (comma-separated). Empty: any origin in
# development, same-origin only in production.
CORS_ORIGINS=
# Reverse proxies in front of the API (Vercel/Nginx/Cloudflare = 1) so limits see the real IP.
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=120
# Experimental HLS proxy. Defaults to true in development and false when NODE_ENV=production.
PLAYBACK_ENABLED=
PLAYBACK_SESSIONS_PER_IP=3
# Player hosts allowed for the embedded HYDRAX server (comma-separated, subdomains included).
EMBED_HOSTS=abyssplayer.com,abysscdn.com,abyss.to
# LK21's series site (drakor and other series). Comma-separated mirrors.
DRAMA_BASE_URLS=https://tv1.nontondrama.vip
# Background catalog crawl: listing pages per 30-minute run (0 disables) and pause after each fetch.
CATALOG_CRAWL_PAGES_PER_RUN=20
CATALOG_CRAWL_DELAY_MS=2000
