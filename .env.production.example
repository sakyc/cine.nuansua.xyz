# Copy to .env on the VPS (next to docker-compose.yml) and fill in the values.
# Never commit the real .env.

# Public URL of the site (used for CORS). The domain's DNS must point to this server.
CORS_ORIGINS=https://cine.nuansua.xyz

# Behind Apache/cPanel or Nginx (default): Cine listens on 127.0.0.1:8088 and the web server proxies
# the domain to it and provides HTTPS. Change the port if 8088 is taken.
WEB_BIND=127.0.0.1:8088
TRUST_PROXY=2
# Standalone server where ports 80/443 are free instead:
# WEB_BIND=80
# WEB_TLS_BIND=443
# SITE_ADDRESS=cine.nuansua.xyz
# TRUST_PROXY=1

# Use long random hex values (URL-safe), e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex
CRON_SECRET=replace-with-random-hex

# Optional: automatic movie subtitles (https://www.opensubtitles.com/consumers)
OPENSUBTITLES_API_KEY=

# P2P server (480p) streams video through this VPS and uses its bandwidth. HYDRAX (up to 1080p)
# does not. Set to true to also offer P2P as a fallback server.
PLAYBACK_ENABLED=false

# Source mirrors, if LK21 or the series site moves to a new domain (comma-separated).
# LK21_BASE_URLS=https://tv13.lk21official.cc
# DRAMA_BASE_URLS=https://tv1.nontondrama.vip
# UPSTREAM_REDIRECT_HOSTS=lk21.de,lk21official.cc,lk21official.dev,nontondrama.vip

# Background catalog crawl (pages per 30 minutes, pause between fetches)
# CATALOG_CRAWL_PAGES_PER_RUN=20
# CATALOG_CRAWL_DELAY_MS=2000
