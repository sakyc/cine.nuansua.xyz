# DOMAIN comes from the environment (cine.nuansua.xyz). Caddy obtains and renews the HTTPS
# certificate automatically once the domain's DNS points at this server and ports 80/443 are open.
{$DOMAIN:cine.nuansua.xyz} {
	encode zstd gzip

	# Backend API and its documentation
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /api-docs* {
		reverse_proxy api:3000
	}

	# Single-page app: unknown paths fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
