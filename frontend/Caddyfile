# Serves the frontend and proxies /api to the backend.
#
# Default (SITE_ADDRESS unset): plain HTTP on :80 inside the container, for a server where another web
# server (Apache/cPanel, Nginx) already owns ports 80/443, terminates HTTPS and proxies the domain here.
# Standalone server: set SITE_ADDRESS=cine.nuansua.xyz and WEB_BIND/WEB_TLS_BIND so Caddy owns 80/443
# and gets the HTTPS certificate itself.
{
	servers {
		# Keep the viewer IP forwarded by the front web server (Docker/private network only).
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Backend API and its documentation
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /api-docs* {
		reverse_proxy api:3000
	}

	# Single-page app: unknown paths fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
