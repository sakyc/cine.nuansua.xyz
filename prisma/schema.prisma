generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Movie {
  id             String    @id @default(uuid())
  title          String
  original_title String?
  slug           String    @unique
  poster         String?
  backdrop       String?
  description    String?
  language       String?
  release_date   DateTime?
  year           Int?
  runtime        Int?
  rating         Float?
  status         String?
  thumbnail      String?
  last_updated   DateTime  @updatedAt

  genres    Genre[]
  countries Country[]
  directors Person[]  @relation("MovieDirectors")
  writers   Person[]  @relation("MovieWriters")
  cast      Person[]  @relation("MovieCast")
  studios   Studio[]
  tags      Tag[]

  @@index([slug])
  @@index([year])
  @@index([rating])
}

model Series {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  poster         String?
  description    String?
  rating         Float?
  year           Int?
  status         String?
  total_episodes Int?
  last_updated   DateTime  @updatedAt

  genres    Genre[]
  countries Country[]
  studios   Studio[]
  episodes  Episode[]

  @@index([slug])
  @@index([year])
}

model Episode {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  episode_number Int
  season_number  Int
  thumbnail      String?
  release_date   DateTime?

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id])

  @@index([seriesId])
}

model Genre {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Country {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Person {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique

  directedMovies Movie[] @relation("MovieDirectors")
  writtenMovies  Movie[] @relation("MovieWriters")
  actedInMovies  Movie[] @relation("MovieCast")
}

model Studio {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Tag {
  id     String  @id @default(uuid())
  name   String  @unique
  movies Movie[]
}

model CatalogEntry {
  slug      String   @id
  title     String
  type      String
  card      Json
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model CatalogSnapshot {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}
