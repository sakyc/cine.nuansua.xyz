generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CatalogEntry {
  slug      String   @id
  title     String
  type      String
  card      Json
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model CatalogSnapshot {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}
